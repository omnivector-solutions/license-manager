# License Manager prolog/epilog configuration.
#
# This file is sourced as a shell script by the prolog and epilog scripts.
# Install it at /etc/default/license-manager (the default path), or point
# the scripts at a custom location via the LM_CONFIG_FILE environment variable.
#
# Copy to your target path and fill in the values for your deployment:
#   cp .env.example /etc/default/license-manager

# Base URL of the License Manager API (no trailing slash).
LM_API_BASE_URL="https://lm-api.example.com"

# OIDC token endpoint host and realm path, e.g. "auth.example.com/realms/my-realm".
OIDC_DOMAIN="auth.example.com/realms/my-realm"
OIDC_CLIENT_ID="license-manager-client"
OIDC_CLIENT_SECRET="change-me"

# Set to "false" to use http:// for the OIDC endpoint (testing only). Default: true.
OIDC_USE_HTTPS="true"

# Directory where the cached OIDC token is stored.
LM_CACHE_DIR="/var/cache/license-manager"

# Number of attempts for network requests before giving up.
LM_MAX_ATTEMPTS="3"

# Base delay (seconds) between retries; doubled after each failed attempt.
LM_RETRY_DELAY="2"
